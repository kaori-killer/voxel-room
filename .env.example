# Supabase — 방 저장과 채팅. 없으면 앱은 뜨지만 공유와 채팅이 꺼진다.
NEXT_PUBLIC_SUPABASE_URL=
# 서버 전용 비밀 키. service_role(구) 또는 secret(신) 중 하나만 있으면 된다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 배포 주소 — 공유 카드의 절대 URL 을 만드는 데 쓴다.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (선택)
NEXT_PUBLIC_GA_ID=G-9P42657YHZ

# Sentry — 에러 리포팅. DSN 이 없으면 SDK 가 통째로 꺼져 앱은 그대로 뜬다.
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (선택) — 셋 다 있어야 빌드 시 업로드한다. 없으면 업로드만 건너뛴다.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# 관리자 채팅 비밀번호 (선택) — 예시 값을 그대로 쓰지 않는다
ADMIN_PASSCODE=
